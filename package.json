{
  "name": "dsh-full-access-switch",
  "version": "0.1.0",
  "description": "DSH 一次性 Full access 开关：新工作区/新对话不再逐个确认（patch 工具 + 安装/卸载脚本）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permission",
    "full-access",
    "cordis"
  ],
  "license": "MIT",
  "author": "xtd1145",
  "scripts": {
    "install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./uninstall.ps1"
  },
  "dependencies": {
    "cordis": "^4.0.1"
  }
}
