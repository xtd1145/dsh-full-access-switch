{
  "name": "dsh-full-access-switch",
  "version": "0.1.0",
  "description": "DSH Full access 一次性开关：新工作区/新对话默认 full access，不再逐个确认（可安装 bundle + 补丁工具）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permission",
    "full-access",
    "cordis"
  ],
  "license": "MIT",
  "author": "xtd1145",
  "scripts": {
    "install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./uninstall.ps1"
  },
  "dependencies": {
    "cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
